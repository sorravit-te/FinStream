	column MetricShortName =
			
			SWITCH(
			    TRUE(),
			
			    'analytics mart_company_financial_growth'[metric_name]
			        = "Equity Attributable to Parent",
			        "Equity",
			
			    'analytics mart_company_financial_growth'[metric_name]
			        = "Net Income (Loss) Attributable to Parent",
			        "Net Income",
			
			    'analytics mart_company_financial_growth'[metric_name]
			        = "Operating Cash Flow",
			        "Operating Cash Flow",
			
			    CONTAINSSTRING(
			        'analytics mart_company_financial_growth'[metric_name],
			        "Revenue from Contracts with Customers"
			    ),
			        "Revenue",
			
			    'analytics mart_company_financial_growth'[metric_name]
			        = "Total Assets",
			        "Total Assets",
			
			    'analytics mart_company_financial_growth'[metric_name]
			        = "Total Liabilities",
			        "Total Liabilities",
			
			    'analytics mart_company_financial_growth'[metric_name]
			)
		lineageTag: e27eadfc-c862-421f-97dc-9c417e4c1914
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'analytics mart_company_financial_growth' = m
		mode: import
		source =
				let
				    Source =
				        PostgreSQL.Database(
				            "localhost:5433",
				            "finstream",
				            [
				                Query = "
				SELECT
				    company_key,
				    current_ticker,
				    source_cik,
				    metric_key,
				    metric_name,
				    period_type,
				    taxonomy,
				    concept,
				    unit,
				    fiscal_year,
				    start_date,
				    end_date,
				    CAST(current_value AS double precision) AS current_value,
				    previous_end_date,
				    CAST(previous_value AS double precision) AS previous_value,
				    CAST(absolute_change AS double precision) AS absolute_change,
				    CAST(growth_rate AS double precision) AS growth_rate,
				    form,
				    filed_date,
				    accession_number
				FROM analytics.mart_company_financial_growth
				"
				            ]
				        )
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

