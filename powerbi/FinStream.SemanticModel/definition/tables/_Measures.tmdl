	measure 'Financial Context Is Valid' =
			
			VAR CompanyCount =
			    CALCULATE(
			        DISTINCTCOUNT(DimCompany[CompanyKey]),
			        ALLSELECTED(DimCompany[CompanyKey])
			    )
			VAR MetricCount =
			    CALCULATE(
			        DISTINCTCOUNT(
			            'analytics mart_company_financial_growth'[metric_key]
			        ),
			        ALLSELECTED(
			            'analytics mart_company_financial_growth'[metric_key]
			        )
			    )
			VAR UnitCount =
			    CALCULATE(
			        DISTINCTCOUNT(
			            'analytics mart_company_financial_growth'[unit]
			        ),
			        ALLSELECTED(
			            'analytics mart_company_financial_growth'[unit]
			        )
			    )
			RETURN
			    IF(
			        CompanyCount = 1
			            && MetricCount = 1
			            && UnitCount = 1,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 0022c408-dcd5-448d-ab8c-ef06f9ca7069

