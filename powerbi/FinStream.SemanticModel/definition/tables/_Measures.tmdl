	measure 'Latest Trading Date' =
			
			IF(
			    HASONEVALUE(DimCompany[CompanyKey]),
			    MAX(
			        'analytics mart_company_daily_performance'[trading_date]
			    )
			)
		formatString: General Date
		lineageTag: 124e4333-81e7-4258-a48d-cf6a52b5b782

	measure 'Latest Close' =
			
			VAR LatestDate =
			    [Latest Trading Date]
			RETURN
			    IF(
			        HASONEVALUE(DimCompany[CompanyKey])
			            && NOT ISBLANK(LatestDate),
			        CALCULATE(
			            SELECTEDVALUE(
			                'analytics mart_company_daily_performance'[close]
			            ),
			            KEEPFILTERS(
			                'analytics mart_company_daily_performance'[trading_date]
			                    = LatestDate
			            )
			        )
			    )
		lineageTag: 4bb8dc05-9203-41e0-a59a-98fc1117be05

		annotation PBI_FormatHint = {"isGeneralNumber":true}

