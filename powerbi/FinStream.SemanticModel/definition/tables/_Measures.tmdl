	measure 'Prior Comparable Value' =
			
			VAR LatestDate =
			    [Latest Reporting Period]
			VAR PriorValue =
			    CALCULATE(
			        SELECTEDVALUE(
			            'analytics mart_company_financial_growth'[previous_value]
			        ),
			        KEEPFILTERS(
			            'analytics mart_company_financial_growth'[end_date]
			                = LatestDate
			        )
			    )
			VAR ComparableChange =
			    CALCULATE(
			        SELECTEDVALUE(
			            'analytics mart_company_financial_growth'[absolute_change]
			        ),
			        KEEPFILTERS(
			            'analytics mart_company_financial_growth'[end_date]
			                = LatestDate
			        )
			    )
			RETURN
			    IF(
			        [Financial Context Is Valid] = 1
			            && NOT ISBLANK(LatestDate)
			            && NOT ISBLANK(ComparableChange),
			        PriorValue
			    )
		lineageTag: 5ac704c6-0de0-4d66-9d3b-bc82b4ed5b45

		annotation PBI_FormatHint = {"isGeneralNumber":true}

