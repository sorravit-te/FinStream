table _Measures
	isHidden
	lineageTag: ddff45d7-af0c-4177-afb6-ede944928621

	measure Close =
			
			IF(
			    HASONEVALUE(DimCompany[CompanyKey]),
			    SELECTEDVALUE(
			        'analytics mart_company_daily_performance'[close]
			    )
			)
		lineageTag: 3948e3fd-0960-4185-bb13-6be7e7adc9a9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Daily Return' =
			
			IF(
			    HASONEVALUE(DimCompany[CompanyKey]),
			    SELECTEDVALUE(
			        'analytics mart_company_daily_performance'[daily_return]
