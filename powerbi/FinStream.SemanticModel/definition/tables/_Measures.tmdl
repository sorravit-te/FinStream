	measure 'Selected Period Return' =
			
			VAR StartClose =
			    [Period Start Close]
			
			VAR EndClose =
			    [Period End Close]
			
			VAR TradingDayCount =
			    CALCULATE(
			        DISTINCTCOUNT(
			            'analytics mart_company_daily_performance'[trading_date]
			        )
			    )
			
			RETURN
			    IF(
			        HASONEVALUE(DimCompany[CompanyKey])
			            && TradingDayCount >= 2
			            && NOT ISBLANK(StartClose)
			            && NOT ISBLANK(EndClose)
			            && StartClose <> 0,
			        DIVIDE(
			            EndClose,
			            StartClose
			        ) - 1
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e8cc3888-a188-4e16-aa22-acca23179f77

