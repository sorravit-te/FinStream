	partition 'analytics mart_market_macro' = m
		mode: import
		source =
				let
				    Source =
				        PostgreSQL.Database(
				            "localhost:5433",
				            "finstream",
				            [
				                Query = "
				SELECT
				    company_key,
				    current_ticker,
				    current_cik,
				    company_name,
				    trading_date,
				    series_id,
				    market_close,
				    market_volume,
				    macro_observation_date,
				    CAST(macro_value AS double precision) AS macro_value,
				    macro_age_days
				FROM analytics.mart_market_macro
				"
				            ]
				        )
				in
				    Source

