	partition DimDate = calculated
		mode: import
		source =
				
				VAR AllDates =
				    FILTER(
				        UNION(
				            SELECTCOLUMNS(
				                'analytics mart_company_daily_performance',
				                "DateValue",
				                'analytics mart_company_daily_performance'[trading_date]
				            ),
				            SELECTCOLUMNS(
				                'analytics mart_company_financial_growth',
				                "DateValue",
				                'analytics mart_company_financial_growth'[start_date]
				            ),
				            SELECTCOLUMNS(
				                'analytics mart_company_financial_growth',
				                "DateValue",
				                'analytics mart_company_financial_growth'[end_date]
				            ),
				            SELECTCOLUMNS(
				                'analytics mart_company_financial_growth',
				                "DateValue",
				                'analytics mart_company_financial_growth'[previous_end_date]
				            ),
				            SELECTCOLUMNS(
				                'analytics mart_company_financial_growth',
				                "DateValue",
				                'analytics mart_company_financial_growth'[filed_date]
				            ),
				            SELECTCOLUMNS(
				                'analytics mart_market_macro',
				                "DateValue",
				                'analytics mart_market_macro'[trading_date]
				            ),
				            SELECTCOLUMNS(
				                'analytics mart_market_macro',
				                "DateValue",
				                'analytics mart_market_macro'[macro_observation_date]
				            )
				        ),
				        NOT ISBLANK([DateValue])
				    )
				
				VAR MinDate =
				    MINX(AllDates, [DateValue])
				
				VAR MaxDate =
				    MAXX(AllDates, [DateValue])
				
				RETURN
				    ADDCOLUMNS(
				        CALENDAR(MinDate, MaxDate),
				        "CalendarYear", YEAR([Date]),
				        "YearMonth", FORMAT([Date], "yyyy-MM"),
				        "YearMonthSort", YEAR([Date]) * 100 + MONTH([Date]),
				        "MonthNumber", MONTH([Date]),
				        "MonthName", FORMAT([Date], "MMM"),
				        "QuarterNumber", QUARTER([Date]),
				        "YearQuarter",
				            FORMAT([Date], "yyyy") & "-Q" & QUARTER([Date]),
				        "YearQuarterSort",
				            YEAR([Date]) * 10 + QUARTER([Date]),
				        "WeekdayNumber", WEEKDAY([Date], 2),
				        "WeekdayName", FORMAT([Date], "ddd")
				    )

	annotation PBI_Id = 2764d6b099754342aad4caaf02c71fd3

