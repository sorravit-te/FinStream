# Docker Compose host exposure
POSTGRES_HOST_PORT=5433

# PostgreSQL bootstrap administrator
POSTGRES_ADMIN_USER=finstream_admin
POSTGRES_ADMIN_PASSWORD=

# FinStream database
FINSTREAM_POSTGRES_DB=finstream
FINSTREAM_POSTGRES_USER=finstream
FINSTREAM_POSTGRES_PASSWORD=

# Airflow metadata database
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=

# Airflow local runtime
AIRFLOW_HOST_PORT=8080
AIRFLOW_API_JWT_SECRET=
